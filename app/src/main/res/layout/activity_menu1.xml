<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0E6"
    tools:context=".activity_splash">

    <!-- Encabezado -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/dark_brown"
        android:orientation="vertical"
        android:padding="10dp">

        <RelativeLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@color/dark_brown"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="156dp"
                android:layout_height="61dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="0dp"
                android:fontFamily="@font/playfair_display_bold"
                android:text="Good morning, @name:"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/btn_notifications"
                android:layout_width="34dp"
                android:layout_height="33dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="31dp"
                android:background="@android:color/transparent"
                android:contentDescription="Notifications"
                android:src="@drawable/ic_notifications"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/logo_image"
                android:layout_width="98dp"
                android:layout_height="46dp"
                android:layout_above="@id/btn_notifications"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="-3dp"
                android:adjustViewBounds="true"
                android:contentDescription="App Logo"
                android:scaleType="fitCenter"
                android:src="@drawable/NB_Logo" />

        </RelativeLayout>

        <TextView
            android:id="@+id/greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Good morning, @name:"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Botones de categoría -->
    <LinearLayout
        android:id="@+id/category_buttons"
        android:layout_below="@id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <ImageButton
            android:id="@+id/btn_iced"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:layout_margin="5dp"
            android:adjustViewBounds="true"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:src="@drawable/icedfavorites"
            android:background="@drawable/imagesbutton"
            android:contentDescription="Cold Brew" />

        <ImageButton
            android:id="@+id/btn_hot"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="5dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:src="@drawable/hotfavorites"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:background="@drawable/imagesbutton"
            android:contentDescription="Cappuccino" />

        <ImageButton
            android:id="@+id/btn_sweet"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:layout_margin="5dp"
            android:adjustViewBounds="true"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:src="@drawable/sweetdelicacies"
            android:background="@drawable/imagesbutton"
            android:contentDescription="Sweet" />

        <ImageButton
            android:id="@+id/btn_savory"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="5dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:src="@drawable/savorydelicacies"
            android:background="@drawable/imagesbutton"
            android:contentDescription="Savory" />
    </LinearLayout>

    <!-- Lista de productos -->
    <ScrollView
        android:id="@+id/drink_scroll"
        android:layout_below="@id/category_buttons"
        android:layout_above="@id/footer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <GridLayout
            android:id="@+id/product_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="3"
            android:orientation="horizontal"
            android:padding="8dp"
            android:useDefaultMargins="true"
            android:alignmentMode="alignMargins"
            android:rowOrderPreserved="false">


            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                card_view:cardCornerRadius="16dp"
                card_view:cardElevation="6dp"
                android:background="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/icedfavorites"
                        android:background="@drawable/image_border"
                        android:clipToOutline="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Iced Coffee Frappé"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#4B1E2F"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/playfair_display_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chilled coffee blended with ice and cream."
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textSize="8sp"
                        android:textColor="#555555"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/tv_price"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="$55"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#000000" />

                        <ImageButton
                            android:id="@+id/addButton"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_input_add"
                            android:tint="#4B1E2F"
                            android:contentDescription="Add to cart" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Producto 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                card_view:cardCornerRadius="16dp"
                card_view:cardElevation="6dp"
                android:background="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/hotfavorites"
                        android:background="@drawable/image_border"
                        android:clipToOutline="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hot Cappuccino"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#4B1E2F"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/playfair_display_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Smooth espresso with steamed milk foam."
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textSize="8sp"
                        android:textColor="#555555"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/tv_price"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="$55"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#000000" />

                        <ImageButton
                            android:id="@+id/addButton"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_input_add"
                            android:tint="#4B1E2F"
                            android:contentDescription="Add to cart" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Producto 3 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                card_view:cardCornerRadius="16dp"
                card_view:cardElevation="6dp"
                android:background="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sweetdelicacies"
                        android:background="@drawable/image_border"
                        android:clipToOutline="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chocolate Muffin"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#4B1E2F"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/playfair_display_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delicious muffin with melted chocolate chips."
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textSize="8sp"
                        android:textColor="#555555"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/tv_price"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="$55"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#000000" />

                        <ImageButton
                            android:id="@+id/addButton"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_input_add"
                            android:tint="#4B1E2F"
                            android:contentDescription="Add to cart" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </GridLayout>
    </ScrollView>
    <!-- 🔻 Footer con 3 ImageButtons -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/dark_brown"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_home"
            android:scaleType="centerInside"
            android:contentDescription="Home"
            android:tint="#FFFFFF"
            android:layout_marginHorizontal="25dp" />

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_menu"
            android:scaleType="centerInside"
            android:contentDescription="Menu"
            android:tint="#FFFFFF"
            android:layout_marginHorizontal="25dp" />

        <ImageButton
            android:id="@+id/btn_cart"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_cart"
            android:scaleType="centerInside"
            android:contentDescription="Cart"
            android:tint="#FFFFFF"
            android:layout_marginHorizontal="25dp" />
    </LinearLayout>

</RelativeLayout>
