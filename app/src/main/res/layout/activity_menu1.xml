<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0E6"
    tools:context=".activity_splash">

    <!-- Encabezado -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/dark_brown"
        android:orientation="vertical"
        android:padding="10dp">

        <RelativeLayout
            android:id="@+id/headerRl"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@color/dark_brown"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/greetingRL"
                android:layout_width="156dp"
                android:layout_height="61dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="0dp"
                android:fontFamily="@font/playfair_display_bold"
                android:text="Good morning, @name"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/btn_notifications"
                android:layout_width="34dp"
                android:layout_height="33dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="31dp"
                android:background="@android:color/transparent"
                android:contentDescription="Notifications"
                android:src="@drawable/ic_notifications"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/logo_image"
                android:layout_width="98dp"
                android:layout_height="46dp"
                android:layout_above="@id/btn_notifications"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="-3dp"
                android:adjustViewBounds="true"
                android:contentDescription="App Logo"
                android:scaleType="fitCenter"
                android:src="@drawable/nb_logo" />

        </RelativeLayout>

        <TextView
            android:id="@+id/greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display_bold"
            android:text="Good morning, @name:"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Botones de categoría -->
    <LinearLayout
        android:id="@+id/category_buttons"
        android:layout_below="@id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <ImageButton
            android:id="@+id/btn_iced"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:layout_margin="5dp"
            android:adjustViewBounds="true"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:src="@drawable/icedfavorites"
            android:background="@drawable/imagesbutton"
            android:contentDescription="Cold Brew" />

        <ImageButton
            android:id="@+id/btn_hot"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="5dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:src="@drawable/hotfavorites"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:background="@drawable/imagesbutton"
            android:contentDescription="Cappuccino" />

        <ImageButton
            android:id="@+id/btn_sweet"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:layout_margin="5dp"
            android:adjustViewBounds="true"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:src="@drawable/sweetdelicacies"
            android:background="@drawable/imagesbutton"
            android:contentDescription="Sweet" />

        <ImageButton
            android:id="@+id/btn_savory"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="5dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:src="@drawable/savorydelicacies"
            android:background="@drawable/imagesbutton"
            android:contentDescription="Savory" />
    </LinearLayout>

    <!-- Lista de productos -->
    <!-- 🔻 Footer con 3 ImageButtons -->
    <ScrollView
        android:id="@+id/drink_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/footer"
        android:layout_below="@id/category_buttons"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="0dp"
        android:layout_weight="1">

        <GridLayout
            android:id="@+id/product_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:orientation="horizontal"
            android:padding="8dp"
            android:rowOrderPreserved="false"
            android:useDefaultMargins="true">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerProducts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"/>

        </GridLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/dark_brown"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_home"
            android:scaleType="centerInside"
            android:contentDescription="Home"
            app:tint="#FFFFFF"
            android:layout_marginHorizontal="25dp" />

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_menu"
            android:scaleType="centerInside"
            android:contentDescription="Menu"
            app:tint="#FFFFFF"
            android:layout_marginHorizontal="25dp" />

        <ImageButton
            android:id="@+id/btn_cart"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_cart"
            android:scaleType="centerInside"
            android:contentDescription="Cart"
            app:tint="#FFFFFF"
            android:layout_marginHorizontal="25dp" />
    </LinearLayout>

</RelativeLayout>
